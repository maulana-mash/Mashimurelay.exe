# ==========================================
# Mashimurelay Windows — Git Ignore Rules
# ==========================================

# Rust / Cargo Build Outputs
target/
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# Node & Package Managers
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Large Windows Executables & Build Artifacts
# (Distributed via GitHub Releases)
*.exe
*.msi
*.pdb
Release_Output/*.exe
Release_Output/*.msi

# IDEs & Code Editors
.vscode/
.idea/
*.iml
*.suo
*.user
*.sublime-project
*.sublime-workspace

# OS-Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
*.log
*.tmp
*.bak
